<Window x:Class="ChessInsight.UI.Views.PromotionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Promocija pješaka"
        Width="290" Height="130"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgApp}">

    <StackPanel Margin="16,12">
        <TextBlock Text="Odaberi figuru za promociju:"
                   Foreground="{StaticResource TextSecondary}"
                   FontSize="12" Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="BtnQueen"  Tag="Queen"  Click="Piece_Click"
                    Width="52" Height="52" FontSize="30" Margin="4,0"
                    Style="{StaticResource BtnBase}"/>
            <Button x:Name="BtnRook"   Tag="Rook"   Click="Piece_Click"
                    Width="52" Height="52" FontSize="30" Margin="4,0"
                    Style="{StaticResource BtnBase}"/>
            <Button x:Name="BtnBishop" Tag="Bishop" Click="Piece_Click"
                    Width="52" Height="52" FontSize="30" Margin="4,0"
                    Style="{StaticResource BtnBase}"/>
            <Button x:Name="BtnKnight" Tag="Knight" Click="Piece_Click"
                    Width="52" Height="52" FontSize="30" Margin="4,0"
                    Style="{StaticResource BtnBase}"/>
        </StackPanel>
    </StackPanel>
</Window>
