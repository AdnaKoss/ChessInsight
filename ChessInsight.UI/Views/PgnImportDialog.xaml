<Window x:Class="ChessInsight.UI.Views.PgnImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Učitaj PGN partiju"
        Width="540" Height="400"
        MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="#08111F"
        ResizeMode="CanResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Zalijepite PGN tekst partije:"
                   Foreground="#80D0DCF0" FontSize="12"
                   Margin="0,0,0,8"/>

        <Border Grid.Row="1"
                BorderBrush="#26FFFFFF" BorderThickness="1"
                CornerRadius="6" Background="#102035">
            <TextBox x:Name="TxtPgn"
                     Background="Transparent"
                     Foreground="#D0DCF0"
                     BorderThickness="0"
                     Padding="10,8"
                     FontFamily="Consolas" FontSize="12"
                     AcceptsReturn="True"
                     AcceptsTab="False"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     CaretBrush="#D0DCF0"
                     VerticalAlignment="Stretch"/>
        </Border>

        <TextBlock Grid.Row="2"
                   x:Name="TxtError"
                   Foreground="#D85A30"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Visibility="Collapsed"/>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="2"
                    Content="Odustani"
                    Width="90" Height="34"
                    Style="{StaticResource BtnBase}"
                    Click="BtnCancel_Click"/>

            <Button Grid.Column="4"
                    Content="✓  Učitaj"
                    Width="100" Height="34"
                    Style="{StaticResource BtnAnalyze}"
                    Click="BtnOk_Click"
                    IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
