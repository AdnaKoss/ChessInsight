<UserControl x:Class="ChessInsight.UI.Views.BoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
             PreviewMouseLeftButtonDown="Board_PreviewMouseDown"
             PreviewMouseMove="Board_PreviewMouseMove"
             PreviewMouseLeftButtonUp="Board_PreviewMouseUp">
    <Border BorderBrush="#555860" BorderThickness="2">
        <ItemsControl x:Name="BoardGrid"
                      ItemsSource="{Binding Squares}">

            <!-- UniformGrid 8x8 -->
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="8" Columns="8"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <!-- Svaki ContentPresenter da se rasteže na cijelu ćeliju -->
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="VerticalAlignment"   Value="Stretch"/>
                </Style>
            </ItemsControl.ItemContainerStyle>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Tag="{Binding Index}"
                            Click="Square_Click"
                            Cursor="Hand"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="SquareBorder"
                                        Background="{Binding Background}"
                                        BorderThickness="0">
                                    <Grid>
                                        <!-- SVG figura (prikazuje se kad postoji slika) -->
                                        <svgc:SvgViewbox Source="{Binding PieceSvgUri}"
                                                         Margin="{Binding PieceMargin}"
                                                         Stretch="Uniform"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         IsHitTestVisible="False"/>

                                        <!-- Unicode fallback (prikazuje se kad SVG ne postoji) -->
                                        <TextBlock Text="{Binding PieceSymbol}"
                                                   FontFamily="Segoe UI Symbol"
                                                   FontSize="38"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding PieceColor}"
                                                   IsHitTestVisible="False"
                                                   Visibility="{Binding PieceSvgUri,
                                                       Converter={StaticResource NullToVis}}"/>

                                        <!-- Lichess-style kružić za legalni potez na praznom polju -->
                                        <Grid IsHitTestVisible="False"
                                              Visibility="{Binding IsLegalMove, Converter={StaticResource BoolToVis}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="4*"/>
                                                <RowDefinition Height="3*"/>
                                                <RowDefinition Height="4*"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4*"/>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="4*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Row="1" Grid.Column="1"
                                                     Fill="#55000000"/>
                                        </Grid>

                                        <!-- Lichess-style prsten za legalno hvatanje figure -->
                                        <Ellipse Margin="4"
                                                 Fill="Transparent"
                                                 Stroke="#55000000"
                                                 StrokeThickness="8"
                                                 IsHitTestVisible="False"
                                                 Visibility="{Binding IsLegalCapture, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SquareBorder"
                                                Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="SquareBorder"
                                                Property="Opacity" Value="0.70"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>

                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>
