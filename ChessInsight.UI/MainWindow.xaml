<Window x:Class="ChessInsight.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ChessInsight.UI.Views"
        Title="ChessInsight — Analiza šahovskih pozicija"
        Width="1050" Height="750"
        MinWidth="850" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">
    <Window.Background>
        <RadialGradientBrush GradientOrigin="0.5,0.4" Center="0.5,0.4" RadiusX="0.9" RadiusY="0.8">
            <GradientStop Color="#142848" Offset="0"/>
            <GradientStop Color="#0C1C38" Offset="0.5"/>
            <GradientStop Color="#05101E" Offset="1"/>
        </RadialGradientBrush>
    </Window.Background>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Naslov -->
            <RowDefinition Height="48"/>
            <!-- Glavni sadržaj: tabla + panel -->
            <RowDefinition Height="*"/>
            <!-- FEN traka -->
            <RowDefinition Height="Auto"/>
            <!-- Toolbar -->
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════
             Red 0 — Naslov aplikacije
             ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource BgToolbar}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="18,0">
                <TextBlock Text="♟" FontSize="22" Foreground="{StaticResource TextAccent}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="ChessInsight" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                <TextBlock Text="  —  Analiza šahovskih pozicija"
                           FontSize="13" Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════
             Red 1 — Eval bar + Tabla (lijevo) + Panel (desno)
             ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Eval bar — vertikalni sidebar -->
                <ColumnDefinition Width="34"/>
                <!-- Tabla — kvadratna, rasteže se -->
                <ColumnDefinition Width="*"/>
                <!-- Separator -->
                <ColumnDefinition Width="1"/>
                <!-- Analitički panel — fiksna širina -->
                <ColumnDefinition Width="352"/>
            </Grid.ColumnDefinitions>

            <!-- ── Eval bar ──────────────────────────────────────── -->
            <Border Grid.Column="0"
                    Margin="6,16,6,16"
                    CornerRadius="4"
                    ClipToBounds="True"
                    Background="#08111F">
                <Grid>
                    <!-- Bijela sekcija raste od dna — ScaleTransform je pouzdan u WPF -->
                    <Rectangle Fill="#D0D8E8"
                               VerticalAlignment="Stretch"
                               RenderTransformOrigin="0.5,1">
                        <Rectangle.RenderTransform>
                            <ScaleTransform ScaleY="{Binding EvalBarWhiteRatio}"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <!-- Linija razdvajanja — uvijek vidljiva -->
                    <Rectangle Height="3" VerticalAlignment="Center"
                               Fill="#888888" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- ── Lijevo: šahovska tabla (Viewbox čuva omjer 1:1) ── -->
            <Viewbox Grid.Column="1"
                     Stretch="Uniform"
                     Margin="16"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <views:BoardView Width="500" Height="500"/>
            </Viewbox>

            <!-- ── Separator ──────────────────────────────────── -->
            <Rectangle Grid.Column="2">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                        <GradientStop Color="#18FFFFFF" Offset="0.2"/>
                        <GradientStop Color="#18FFFFFF" Offset="0.8"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- ── Desno: Analitički panel ────────────────────── -->
            <Grid Grid.Column="3">
                <!-- Glass layers -->
                <Border Background="#0EFFFFFF"
                        BorderBrush="#22FFFFFF"
                        BorderThickness="1,0,0,0"/>
                <Rectangle VerticalAlignment="Top" Height="180" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#0CFFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- Content -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Evaluacija -->
                        <RowDefinition Height="Auto"/>  <!-- Loading indicator -->
                        <RowDefinition Height="Auto"/>  <!-- Top 3 poteza -->
                        <RowDefinition Height="Auto"/>  <!-- Statistike -->
                        <RowDefinition Height="*"/>     <!-- Istorija poteza -->
                        <RowDefinition Height="Auto"/>  <!-- Dugme Analiziraj -->
                    </Grid.RowDefinitions>

                    <!-- Evaluacija pozicije -->
                    <Border Grid.Row="0" Background="#12FFFFFF"
                            BorderBrush="#1EFFFFFF" BorderThickness="1"
                            Margin="12,14,12,0" CornerRadius="6" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="EVALUACIJA POZICIJE"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="10" FontWeight="Bold"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding ScoreText}"
                                       Foreground="{StaticResource TextAccent}"
                                       FontSize="28" FontWeight="Bold"
                                       FontFamily="Consolas"/>
                            <TextBlock Text="{Binding ScoreLabelText}"
                                       Foreground="{Binding ScoreLabelColor}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Margin="0,1,0,4"/>
                            <TextBlock Text="{Binding GameStatusText}"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"/>
                            <TextBlock Text="📖  Knjiga otvaranja"
                                       Foreground="#C8A84B"
                                       FontSize="11"
                                       Margin="0,5,0,0"
                                       Visibility="{Binding IsBookPosition,
                                           Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Loading indicator -->
                    <Border Grid.Row="1"
                            Margin="12,6,12,0"
                            Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <ProgressBar IsIndeterminate="True"
                                         Height="3"
                                         Foreground="{StaticResource MoveColorBest}"
                                         Background="Transparent"
                                         BorderThickness="0"/>
                            <TextBlock Text="{Binding AnalyzingText}"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="10"
                                       HorizontalAlignment="Right"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Top 3 poteza -->
                    <Border Grid.Row="2" Background="#12FFFFFF"
                            BorderBrush="#1EFFFFFF" BorderThickness="1"
                            Margin="12,10,12,0" CornerRadius="6" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="TOP 3 POTEZA"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="10" FontWeight="Bold"
                                       Margin="0,0,0,10"/>

                            <!-- Potez 1 — Najbolji -->
                            <Border Background="#1A1D9E75" CornerRadius="4"
                                    Padding="10,7" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="★ 1."
                                               Foreground="{StaticResource MoveColorBest}"
                                               FontWeight="Bold" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Move1Text}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="13" FontFamily="Consolas"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Score1Text}"
                                               Foreground="{StaticResource MoveColorBest}"
                                               FontSize="12" FontFamily="Consolas"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Potez 2 -->
                            <Border Background="#0D4A4A4A" CornerRadius="4"
                                    Padding="10,7" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="  2."
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="13" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Move2Text}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="13" FontFamily="Consolas"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Score2Text}"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="12" FontFamily="Consolas"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Potez 3 -->
                            <Border Background="#0D4A4A4A" CornerRadius="4"
                                    Padding="10,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="  3."
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="13" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Move3Text}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="13" FontFamily="Consolas"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Score3Text}"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="12" FontFamily="Consolas"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Statistike -->
                    <Border Grid.Row="3" Background="#12FFFFFF"
                            BorderBrush="#1EFFFFFF" BorderThickness="1"
                            Margin="12,8,12,0" CornerRadius="6" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="STATISTIKE"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="10" FontWeight="Bold"
                                       Margin="0,0,0,8"/>
                            <UniformGrid Rows="2" Columns="2">
                                <!-- Dubina -->
                                <Border Background="#0CFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1"
                                        CornerRadius="4" Padding="8,6" Margin="0,0,4,4">
                                    <StackPanel>
                                        <TextBlock Text="DUBINA" FontSize="9" FontWeight="Bold"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding DepthText}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   FontFamily="Consolas"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                </Border>
                                <!-- Čvorovi -->
                                <Border Background="#0CFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1"
                                        CornerRadius="4" Padding="8,6" Margin="0,0,0,4">
                                    <StackPanel>
                                        <TextBlock Text="ČVOROVI" FontSize="9" FontWeight="Bold"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding NodesText}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   FontFamily="Consolas"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                </Border>
                                <!-- Vrijeme -->
                                <Border Background="#0CFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1"
                                        CornerRadius="4" Padding="8,6" Margin="0,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="VRIJEME" FontSize="9" FontWeight="Bold"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding TimeText}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   FontFamily="Consolas"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                </Border>
                                <!-- Algoritam -->
                                <Border Background="#0CFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1"
                                        CornerRadius="4" Padding="8,6" Margin="0,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="ALGORITAM" FontSize="9" FontWeight="Bold"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,0,0,2"/>
                                        <TextBlock Text="Alpha-Beta"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   FontFamily="Consolas"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Istorija poteza -->
                    <Border Grid.Row="4" Background="#12FFFFFF"
                            BorderBrush="#1EFFFFFF" BorderThickness="1"
                            Margin="12,8,12,0" CornerRadius="6" Padding="12,10"
                            MinHeight="120">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="ISTORIJA POTEZA"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="10" FontWeight="Bold"
                                       Margin="0,0,0,8"/>

                            <ScrollViewer Grid.Row="1"
                                          x:Name="MoveHistoryScroller"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding MoveHistory}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Number, StringFormat='{}{0}.'}"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           FontSize="12" FontFamily="Consolas"
                                                           VerticalAlignment="Center"
                                                           Padding="0,4"/>

                                                <!-- Bijeli potez -->
                                                <Border Grid.Column="1" CornerRadius="3" Margin="1,1,1,1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsWhiteActive}" Value="True">
                                                                    <Setter Property="Background" Value="#28D4A840"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding WhiteMove}"
                                                               FontSize="12" FontFamily="Consolas"
                                                               Padding="4,4" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                                <Setter Property="FontWeight" Value="Normal"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsWhiteActive}" Value="True">
                                                                        <Setter Property="Foreground" Value="#D4A840"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <!-- Crni potez -->
                                                <Border Grid.Column="2" CornerRadius="3" Margin="1,1,1,1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBlackActive}" Value="True">
                                                                    <Setter Property="Background" Value="#28D4A840"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding BlackMove}"
                                                               FontSize="12" FontFamily="Consolas"
                                                               Padding="4,4" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                                <Setter Property="FontWeight" Value="Normal"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsBlackActive}" Value="True">
                                                                        <Setter Property="Foreground" Value="#D4A840"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Dugme Analizator start/stop -->
                    <Button Grid.Row="5"
                            x:Name="BtnAnalyze"
                            Content="{Binding AnalyzeBtnText}"
                            Margin="12,10,12,12"
                            Height="42"
                            Click="BtnAnalyze_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BtnAnalyze}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAutoAnalyzing}" Value="True">
                                        <Setter Property="Background" Value="#8B1A1A"/>
                                        <Setter Property="BorderBrush" Value="#C0392B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════
             Red 2 — FEN traka
             ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{StaticResource BgToolbar}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,1,0,0">
            <Grid Margin="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="FEN:"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="12" FontFamily="Consolas"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1"
                         x:Name="TxtFen"
                         Style="{StaticResource InputBox}"
                         Text="rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1"
                         VerticalAlignment="Center"
                         KeyDown="TxtFen_KeyDown"
                         ToolTip="Unesite FEN notaciju i pritisnite Enter"/>
                <Button Grid.Column="2"
                        Content="Učitaj"
                        Style="{StaticResource BtnBase}"
                        Margin="8,0,0,0"
                        Click="BtnLoadFen_Click"
                        ToolTip="Učitaj poziciju iz FEN stringa"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════
             Red 3 — Toolbar (donji)
             ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="{StaticResource BgToolbar}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                <Button x:Name="BtnBack"
                        Content="◀"
                        Style="{StaticResource BtnBase}"
                        Click="BtnBack_Click"
                        IsEnabled="{Binding CanGoBack}"
                        ToolTip="Vrati jedan potez unazad"
                        Width="32" Padding="0"
                        Margin="0,0,3,0"/>
                <Button x:Name="BtnForward"
                        Content="▶"
                        Style="{StaticResource BtnBase}"
                        Click="BtnForward_Click"
                        IsEnabled="{Binding CanGoForward}"
                        ToolTip="Idi jedan potez naprijed"
                        Width="32" Padding="0"
                        Margin="0,0,10,0"/>
                <Button x:Name="BtnFlip"
                        Content="⟳  Okreni"
                        Style="{StaticResource BtnBase}"
                        Click="BtnFlip_Click"
                        ToolTip="Obrni orijentaciju table"
                        Margin="0,0,6,0"/>
                <Button x:Name="BtnReset"
                        Content="↺  Reset"
                        Style="{StaticResource BtnBase}"
                        Click="BtnReset_Click"
                        ToolTip="Vrati na početnu poziciju"
                        Margin="0,0,6,0"/>
                <Button x:Name="BtnSetupPosition"
                        Content="✎"
                        Style="{StaticResource BtnBase}"
                        Click="BtnSetupPosition_Click"
                        ToolTip="Postavi figuru"
                        Width="34" Padding="0"
                        FontSize="15"
                        Margin="0,0,6,0"/>
                <Button x:Name="BtnLoadPgn"
                        Content="📄"
                        Style="{StaticResource BtnBase}"
                        Click="BtnLoadPgn_Click"
                        ToolTip="Učitaj PGN partiju"
                        Width="34" Padding="0"
                        FontSize="15"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
