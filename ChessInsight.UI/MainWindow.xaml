<Window x:Class="ChessInsight.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ChessInsight.UI.Views"
        Title="ChessInsight — Analiza šahovskih pozicija"
        Width="1050" Height="750"
        MinWidth="850" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgApp}"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Naslov -->
            <RowDefinition Height="48"/>
            <!-- Glavni sadržaj: tabla + panel -->
            <RowDefinition Height="*"/>
            <!-- FEN traka -->
            <RowDefinition Height="Auto"/>
            <!-- Toolbar -->
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════
             Red 0 — Naslov aplikacije
             ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource BgToolbar}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="18,0">
                <TextBlock Text="♟" FontSize="22" Foreground="{StaticResource TextAccent}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="ChessInsight" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                <TextBlock Text="  —  Analiza šahovskih pozicija"
                           FontSize="13" Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════
             Red 1 — Tabla (lijevo) + Panel (desno)
             ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Tabla — kvadratna, rasteže se -->
                <ColumnDefinition Width="*"/>
                <!-- Separator -->
                <ColumnDefinition Width="1"/>
                <!-- Analitički panel — fiksna širina -->
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <!-- ── Lijevo: šahovska tabla + indikator na potezu ── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Viewbox Grid.Row="0"
                         Stretch="Uniform"
                         Margin="16,16,16,6"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                    <!-- Fiksna unutarnja veličina — Viewbox skalira proporcionalno -->
                    <Grid Width="520" Height="520">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="500"/>
                            <RowDefinition Height="20"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="500"/>
                        </Grid.ColumnDefinitions>

                        <!-- Oznake redova — dinamične (okreću se pri flipu) -->
                        <ItemsControl Grid.Row="0" Grid.Column="0"
                                      ItemsSource="{Binding RowLabels}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="1" Rows="8"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               Foreground="{StaticResource TextSecondary}" FontSize="11"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Šahovska tabla -->
                        <views:BoardView Grid.Row="0" Grid.Column="1"/>

                        <!-- Oznake kolona — dinamične (okreću se pri flipu) -->
                        <ItemsControl Grid.Row="1" Grid.Column="1"
                                      ItemsSource="{Binding ColLabels}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="8"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               Foreground="{StaticResource TextSecondary}" FontSize="11"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Viewbox>

                <!-- Indikator: ko je na potezu -->
                <Border Grid.Row="1"
                        Margin="16,0,16,10"
                        Padding="14,6"
                        Background="{StaticResource BgToolbar}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="5"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="13" Height="13"
                                 Fill="{Binding SideToMoveFill}"
                                 Stroke="{StaticResource BorderColor}"
                                 StrokeThickness="1.5"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding GameStatusText}"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Separator ──────────────────────────────────── -->
            <Rectangle Grid.Column="1" Fill="{StaticResource BorderColor}"/>

            <!-- ── Desno: Analitički panel ────────────────────── -->
            <Border Grid.Column="2" Background="{StaticResource BgPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Evaluacija -->
                        <RowDefinition Height="Auto"/>  <!-- Loading indicator -->
                        <RowDefinition Height="Auto"/>  <!-- Top 3 poteza -->
                        <RowDefinition Height="Auto"/>  <!-- Statistike -->
                        <RowDefinition Height="*"/>     <!-- Istorija poteza -->
                        <RowDefinition Height="Auto"/>  <!-- Dugme Analiziraj -->
                    </Grid.RowDefinitions>

                    <!-- Evaluacija pozicije -->
                    <Border Grid.Row="0" Background="{StaticResource BgCard}"
                            Margin="12,14,12,0" CornerRadius="6" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="EVALUACIJA POZICIJE"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="10" FontWeight="Bold"
                                       Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock x:Name="TxtScore"
                                           Text="{Binding ScoreText}"
                                           Foreground="{StaticResource TextAccent}"
                                           FontSize="28" FontWeight="Bold"
                                           FontFamily="Consolas"/>
                                <TextBlock x:Name="TxtScoreLabel"
                                           Text="{Binding ScoreLabelText, StringFormat='  {0}'}"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="13"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,4"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtGameStatus"
                                       Text="{Binding GameStatusText}"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Loading indicator — vidljiv samo tokom analize -->
                    <Border Grid.Row="1"
                            Margin="12,6,12,0"
                            Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <ProgressBar IsIndeterminate="True"
                                         Height="3"
                                         Foreground="{StaticResource MoveColorBest}"
                                         Background="Transparent"
                                         BorderThickness="0"/>
                            <TextBlock Text="{Binding AnalyzingText}"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="10"
                                       HorizontalAlignment="Right"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Top 3 poteza -->
                    <Border Grid.Row="2" Background="{StaticResource BgCard}"
                            Margin="12,10,12,0" CornerRadius="6" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="TOP 3 POTEZA"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="10" FontWeight="Bold"
                                       Margin="0,0,0,10"/>

                            <!-- Potez 1 — Najbolji -->
                            <Border x:Name="Move1Container"
                                    Background="#1A4CAF50" CornerRadius="4"
                                    Padding="10,7" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="★ 1."
                                               Foreground="{StaticResource MoveColorBest}"
                                               FontWeight="Bold" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtMove1"
                                               Text="{Binding Move1Text}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="13" FontFamily="Consolas"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" x:Name="TxtScore1"
                                               Text="{Binding Score1Text}"
                                               Foreground="{StaticResource MoveColorBest}"
                                               FontSize="12" FontFamily="Consolas"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Potez 2 -->
                            <Border x:Name="Move2Container"
                                    Background="#0D4A4A4A" CornerRadius="4"
                                    Padding="10,7" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="  2."
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="13" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtMove2"
                                               Text="{Binding Move2Text}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="13" FontFamily="Consolas"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" x:Name="TxtScore2"
                                               Text="{Binding Score2Text}"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="12" FontFamily="Consolas"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Potez 3 -->
                            <Border x:Name="Move3Container"
                                    Background="#0D4A4A4A" CornerRadius="4"
                                    Padding="10,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="  3."
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="13" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtMove3"
                                               Text="{Binding Move3Text}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="13" FontFamily="Consolas"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" x:Name="TxtScore3"
                                               Text="{Binding Score3Text}"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="12" FontFamily="Consolas"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Statistike -->
                    <Border Grid.Row="3" Background="{StaticResource BgCard}"
                            Margin="12,8,12,0" CornerRadius="6" Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="STATISTIKE"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="10" FontWeight="Bold"
                                       Margin="0,0,0,6"/>

                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Dubina pretrage"
                                           Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                <TextBlock Grid.Column="1" x:Name="TxtDepth"
                                           Text="{Binding DepthText}" Foreground="{StaticResource TextPrimary}"
                                           FontSize="11" FontFamily="Consolas"/>
                            </Grid>

                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Pregledani čvorovi"
                                           Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                <TextBlock Grid.Column="1" x:Name="TxtNodes"
                                           Text="{Binding NodesText}" Foreground="{StaticResource TextPrimary}"
                                           FontSize="11" FontFamily="Consolas"/>
                            </Grid>

                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Vrijeme analize"
                                           Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                <TextBlock Grid.Column="1" x:Name="TxtTime"
                                           Text="{Binding TimeText}" Foreground="{StaticResource TextPrimary}"
                                           FontSize="11" FontFamily="Consolas"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Algoritam"
                                           Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                <TextBlock Grid.Column="1" x:Name="TxtAlgorithm"
                                           Text="Alpha-Beta" Foreground="{StaticResource TextPrimary}"
                                           FontSize="11" FontFamily="Consolas"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Istorija poteza -->
                    <Border Grid.Row="4" Background="{StaticResource BgCard}"
                            Margin="12,8,12,0" CornerRadius="6" Padding="12,10"
                            MinHeight="120">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="ISTORIJA POTEZA"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="10" FontWeight="Bold"
                                       Margin="0,0,0,8"/>

                            <ScrollViewer Grid.Row="1"
                                          x:Name="MoveHistoryScroller"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding MoveHistory}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Number, StringFormat='{}{0}.'}"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           FontSize="12" FontFamily="Consolas"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding WhiteMove}"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           FontSize="12" FontFamily="Consolas"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding BlackMove}"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           FontSize="12" FontFamily="Consolas"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Dugme Analizator start/stop -->
                    <Button Grid.Row="5"
                            x:Name="BtnAnalyze"
                            Content="{Binding AnalyzeBtnText}"
                            Margin="12,10,12,12"
                            Height="42"
                            Click="BtnAnalyze_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BtnAnalyze}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAutoAnalyzing}" Value="True">
                                        <Setter Property="Background" Value="#8B1A1A"/>
                                        <Setter Property="BorderBrush" Value="#C0392B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════
             Red 2 — FEN traka
             ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{StaticResource BgToolbar}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,1,0,0">
            <Grid Margin="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="FEN:"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="12" FontFamily="Consolas"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1"
                         x:Name="TxtFen"
                         Style="{StaticResource InputBox}"
                         Text="rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1"
                         VerticalAlignment="Center"
                         KeyDown="TxtFen_KeyDown"
                         ToolTip="Unesite FEN notaciju i pritisnite Enter"/>
                <Button Grid.Column="2"
                        Content="Učitaj"
                        Style="{StaticResource BtnBase}"
                        Margin="8,0,0,0"
                        Click="BtnLoadFen_Click"
                        ToolTip="Učitaj poziciju iz FEN stringa"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════
             Red 3 — Toolbar (donji)
             ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="{StaticResource BgToolbar}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="12,0">
                <Button x:Name="BtnBack"
                        Content="◀  Nazad"
                        Style="{StaticResource BtnBase}"
                        Click="BtnBack_Click"
                        IsEnabled="{Binding CanGoBack}"
                        ToolTip="Vrati jedan potez unazad"
                        Margin="0,0,8,0"/>
                <Button x:Name="BtnForward"
                        Content="Naprijed  ▶"
                        Style="{StaticResource BtnBase}"
                        Click="BtnForward_Click"
                        IsEnabled="{Binding CanGoForward}"
                        ToolTip="Idi jedan potez naprijed"
                        Margin="0,0,16,0"/>
                <Button x:Name="BtnFlip"
                        Content="⟳  Okreni Ploču"
                        Style="{StaticResource BtnBase}"
                        Click="BtnFlip_Click"
                        ToolTip="Obrni orijentaciju table"
                        Margin="0,0,8,0"/>
                <Button x:Name="BtnReset"
                        Content="↺  Resetuj"
                        Style="{StaticResource BtnBase}"
                        Click="BtnReset_Click"
                        ToolTip="Vrati na početnu poziciju"
                        Margin="0,0,8,0"/>
                <Button x:Name="BtnSetupPosition"
                        Content="✎  Postavi Figuru"
                        Style="{StaticResource BtnBase}"
                        Click="BtnSetupPosition_Click"
                        ToolTip="Ručno postavi figure na ploču"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
